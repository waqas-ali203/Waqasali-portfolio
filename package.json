{
  "name": "usman-orbital-studio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:static": "ORBITAL_STATIC_EXPORT=1 next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/contact.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:scenes": "node scripts/verify-scenes.mjs",
    "test:cosmos": "node scripts/verify-cosmos.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "format": "prettier --write app components content lib scripts tests next.config.ts",
    "preview:static": "node scripts/preview-static.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "axe-core": "^4.11.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.9.10",
    "puppeteer": "^24.40.0",
    "typescript": "^5.9.3"
  }
}
